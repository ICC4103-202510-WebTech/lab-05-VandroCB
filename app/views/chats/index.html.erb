<h1>All Chats</h1>

<% if can? :create, Chat %>
  <button><%= link_to 'New Chat', new_chat_path %></button>
<% end %>

<table>
  <thead>
    <tr>
      <th>Sender id</th>
      <th>Receiver id</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @chats.each do |chat| %>
      <tr>
        <td><%= chat.sender_id %></td>
        <td><%= chat.receiver_id %></td>
        <td>
          <%= link_to 'View', chat_path(chat) %>
          <% if can? :edit, chat %>
            <%= link_to 'Edit', edit_chat_path(chat), class: 'btn btn-sm btn-warning' %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>