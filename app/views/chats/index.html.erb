<h1>My Chats</h1>

<% if can? :create, Chat %>
  <%= link_to 'Start New Chat', new_chat_path, class: 'btn btn-primary mb-4' %>
<% end %>

<div class="chat-list">
  <% @chats.each do |chat| %>
    <% other_user = chat.sender == current_user ? chat.receiver : chat.sender %>

    <div class="card mb-3">
      <%= link_to chat_path(chat), class: "text-decoration-none text-dark" do %>
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-md-6">
              <h5 class="mb-1"><%= other_user.full_name %></h5>
            </div>
            <% if chat.messages.last %>
              <div class="col-md-6 text-end">
                <p class="mb-1 text-muted">
                  <%= truncate(chat.messages.last.body, length: 50) %>
                </p>
                <small class="text-muted">
                  <span>at: <%= chat.messages.last.created_at.strftime("%H:%M") %></span>
                </small>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

  <% end %>
</div>
