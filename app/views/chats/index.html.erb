<h1>My Chats</h1>

<% if can? :create, Chat %>
  <%= link_to 'Start New Chat', new_chat_path, class: 'btn btn-primary mb-4' %>
<% end %>

<div class="chat-list">
  <% @chats.each do |chat| %>
    <div class="chat-item">
      <% other_user = chat.sender == current_user ? chat.receiver : chat.sender %>
      <%= link_to chat_path(chat), class: "chat-link" do %>
        <div class="chat-preview">
          <h3><%= other_user.full_name %></h3>
          <% if chat.messages.last %>
            <p class="last-message">
              <%= truncate(chat.messages.last.body, length: 50) %>
            </p>
            <small><%= chat.messages.last.created_at.strftime("%H:%M") %></small>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>