<h1>Chat with <%= @chat.receiver == current_user ? @chat.sender.full_name : @chat.receiver.full_name %></h1>

<div id="messages">
  <% @messages.each do |message| %>
    <div class="message <%= 'own-message' if message.user == current_user %>">
      <strong><%= message.user.full_name %>:</strong>
      <%= message.body %>
      <small><%= message.created_at.strftime("%H:%M") %></small>
    </div>
  <% end %>
</div>

<h2>Send a message</h2>
<%= form_with(model: [@chat, @message], local: true) do |form| %>
  <div class="field">
    <%= form.text_area :body, rows: 3, placeholder: "Type your message..." %>
  </div>
  <div class="actions">
    <%= form.submit "Send" %>
  </div>
<% end %>