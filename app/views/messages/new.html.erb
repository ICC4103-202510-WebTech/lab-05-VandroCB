<h1>New Message</h1>

<%= form_with model: @message, local: true do |form| %>
  <% if @message.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading">
        <%= pluralize(@message.errors.count, "error") %> prevented this message from being saved:
      </h4>
      <ul class="mb-0">
        <% @message.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :chat_id, "Chat" %><br>
    <%= form.collection_select :chat_id, @chats, :id, 
          ->(chat) { "#{chat.sender.full_name} ↔ #{chat.receiver.full_name}" }, 
          prompt: "Select a chat" %>
  </div>

  <div class="field">
    <%= form.label :user_id, "Author" %><br>
    <%= form.collection_select :user_id, @users, :id, :full_name, prompt: "Select the author" %>
  </div>

  <div class="field">
    <%= form.label :body, "Message" %><br>
    <%= form.text_area :body, rows: 4 %>
  </div>

  <div class="actions">
    <%= form.submit "Send Message" %>
  </div>
<% end %>