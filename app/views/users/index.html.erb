<h1>All Users</h1>

<!--button><%= link_to 'Register', new_user_path %></button-->

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>First Name</th>
      <th>Last Name</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.email %></td>
        <td><%= user.first_name %></td>
        <td><%= user.last_name %></td>
        <td><%= user.messages.count %></td>
        <td><%= link_to 'View', user_path(user), class: 'btn btn-sm btn-info' %></td>
        <td><%= link_to 'Edit', edit_user_path(user), class: 'btn btn-sm btn-warning' %></td>
      </tr>
    <% end %>
  </tbody>
</table>